{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "chessgum.com" }],
      "destination": "https://www.chessgum.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "academy-lovat-mu.vercel.app" }],
      "destination": "https://www.chessgum.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about",          "destination": "/about.html"          },
    { "source": "/pricing",        "destination": "/pricing.html"        },
    { "source": "/contact",        "destination": "/contact.html"        },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" }
  ],
  "cleanUrls": true
}
